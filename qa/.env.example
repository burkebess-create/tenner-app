# Copy to qa/.env and fill in. Do NOT commit qa/.env — it's gitignored.
TENNER_URL=https://mytenner.com
QA_EMAIL=your-test-account@example.com
QA_PASSWORD=your-test-password

# Second account — enables the `social` flow, the only one that exercises
# anything between two users (Circle feed, cross-account comment authorship).
# The two accounts must be accepted friends. Omit to skip that flow.
QA_EMAIL_2=your-second-test-account@example.com
QA_PASSWORD_2=your-second-test-password
